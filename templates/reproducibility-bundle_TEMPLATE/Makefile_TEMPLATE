	@echo ""
	@echo "Targets:"
	@echo "  make replicate          Re-derive headline results from raw inputs"
	@echo "  make verify-structure   Run the unit's structure check against this publication"
	@echo "  make clean              [No-op in stub / remove recovered-results-*]"
	@echo "  make help               This message"

