# Jupyter
.ipynb_checkpoints/

# uv / pip-tools lockfiles — DO commit these for reproducibility:
# (intentionally NOT in .gitignore)
# uv.lock
# requirements.lock

# Node (in case of supplementary tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*

# Local environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
secrets/

# Large or generated data
# (Project-specific. Per Charter §9, raw data is included in
# reproducibility-bundle/data/ OR a documented access procedure plus checksums
# is provided. Use this section to ignore working data files that should NOT
# be committed, while ensuring published bundles remain complete.)
*.tmp
*.bak
*.log
*.tar
*.tar.gz
*.zip
# Uncomment if your raw data files are very large and stored elsewhere:
# data-raw/
# *.h5
# *.parquet

# Compiled documents (commit the source, not the binary)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
# Leave *.pdf alone here — published manuscripts ARE committed in publications/.

# Local notebook outputs (commit the source notebook, but not the OS-specific run state)
.ipynb_checkpoints/

# Model and checkpoint files (frequently very large; reference by checksum in PROVENANCE.md instead)
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.bin

# Cowork / Claude session artifacts (in case work happens through Cowork)
.cowork/
.claude/
.gstack/
