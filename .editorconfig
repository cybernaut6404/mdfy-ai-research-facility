# EditorConfig (https://editorconfig.org) — root configuration.
# Keeps line endings, indentation, and trailing whitespace consistent across
# editors and contributors.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown allows trailing-space line breaks; don't trim.
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 100

[*.sh]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,toml,cff}]
indent_size = 2

[Makefile]
indent_style = tab
